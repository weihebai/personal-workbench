# 复制为 .env 后填写真实值
# docker compose --env-file .env up -d --build

# 初始管理员账号（首次启动时数据库为空才生效）
ADMIN_USER=admin
ADMIN_PASS=change-me-please

# JWT 密钥：留空则自动生成并保存到 data/.jwt_secret
# 建议手动生成：openssl rand -hex 32
JWT_SECRET=

# 登录有效期（小时），默认 7 天
TOKEN_TTL_HOURS=168

# 图片存放目录。默认 ./data/uploads，容器里即 /app/data/uploads，
# 和数据库同在一个 data/ 卷里，备份时一起带走，通常不用改。
# UPLOAD_DIR=./data/uploads

# 单张图片大小上限（MB），默认 10
MAX_UPLOAD_MB=10

# 备份包导入大小上限（MB），默认 2048。导出不受限。
# 经 Cloudflare Tunnel 传输时单请求上限 100MB，超大备份包请走内网直连
MAX_BACKUP_UPLOAD_MB=2048

# MCP 端点：设置后 AI 客户端可通过 https://<你的域名>/mcp 连接（Streamable HTTP），
# 请求头带 Authorization: Bearer <MCP_TOKEN>。留空则 /mcp 路由关闭。
# 生成：openssl rand -hex 32
MCP_TOKEN=

# Cloudflare Tunnel Token
# 在 Cloudflare Zero Trust -> Networks -> Tunnels 创建隧道后复制
CLOUDFLARE_TUNNEL_TOKEN=

# 数据目录（宿主机路径，数据库/JWT 密钥/图片都放这里）
# 不设置则用 ./data（相对 docker-compose.yml 所在目录）
# 生产建议用绝对路径，避免在错误目录执行 compose 时数据散落
# DATA_DIR=/opt/workbench/data
