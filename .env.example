# 复制为 .env 后填写真实值
# docker compose --env-file .env up -d --build

# 初始管理员账号（首次启动时数据库为空才生效）
ADMIN_USER=admin
ADMIN_PASS=change-me-please

# JWT 密钥：留空则自动生成并保存到 data/.jwt_secret
# 建议手动生成：openssl rand -hex 32
JWT_SECRET=

# 登录有效期（小时），默认 7 天
TOKEN_TTL_HOURS=168

# Cloudflare Tunnel Token
# 在 Cloudflare Zero Trust -> Networks -> Tunnels 创建隧道后复制
CLOUDFLARE_TUNNEL_TOKEN=

# 数据目录（宿主机路径，数据库/JWT 密钥都放这里）
# 不设置则用 ./data（相对 docker-compose.yml 所在目录）
# 生产建议用绝对路径，避免在错误目录执行 compose 时数据散落
# DATA_DIR=/opt/workbench/data
